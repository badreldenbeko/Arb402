# arbitrum | arbitrum-sepolia (or CAIP-2: eip155:42161, eip155:421614)
NETWORK=arbitrum-sepolia

# facilitator wallet private key
EVM_PRIVATE_KEY=0x...

# RPC (optional, defaults provided)
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

PORT=3002

# fees
SERVICE_FEE_BPS=50
GAS_FEE_USDC=100000

# bind settlement to a server-issued requirement (recommended). set false for
# the advisory x402 model where the resource server alone enforces price.
REQUIRE_ISSUED_REQUIREMENTS=true

# minimum facilitator ETH balance (wei) to attempt settlement (default 0.0005)
MIN_FACILITATOR_ETH_WEI=500000000000000

# alert (recovery WARN log + GET /admin/stuck) when a payment stays incomplete
# this long — operator signal to review/prune zombies (default 1h)
STUCK_PAYMENT_ALERT_MS=3600000

# set when behind a proxy/LB so rate limiting sees the real client IP (e.g. 1)
TRUST_PROXY=

# postgres (optional for dev, required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/arb402

# USDC override (for custom test tokens)
USDC_ADDRESS=

# auth
ADMIN_API_KEY_HASH=

# dev/test only — single-merchant fallback so the facilitator can settle
# without a database (used by the local hardhat harness). NEVER set in production.
DEV_MERCHANT_API_KEY_HASH=
DEV_MERCHANT_ADDRESS=
