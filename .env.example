# arbitrum | arbitrum-nova | arbitrum-sepolia, any registered Orbit chain slug,
# or a CAIP-2 id (eip155:42161, eip155:42170, eip155:421614, eip155:<orbit>).
# run `arb402 chains` to list everything currently registered.
NETWORK=arbitrum-sepolia

# facilitator wallet private key
EVM_PRIVATE_KEY=0x...

# RPC (optional, defaults provided). Orbit chains use ORBIT_<chainId>_RPC_URL.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_NOVA_RPC_URL=https://nova.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Orbit chain registry (optional). Defaults to ./arb402.chains.json when present.
# See arb402.chains.example.json for the format.
ARB402_CHAINS_FILE=

PORT=3002

# fees
SERVICE_FEE_BPS=50
GAS_FEE_USDC=100000

# bind settlement to a server-issued requirement (recommended). set false for
# the advisory x402 model where the resource server alone enforces price.
REQUIRE_ISSUED_REQUIREMENTS=true

# minimum facilitator ETH balance (wei) to attempt settlement (default 0.0005)
MIN_FACILITATOR_ETH_WEI=500000000000000

# alert (recovery WARN log + GET /admin/stuck) when a payment stays incomplete
# this long — operator signal to review/prune zombies (default 1h)
STUCK_PAYMENT_ALERT_MS=3600000

# set when behind a proxy/LB so rate limiting sees the real client IP (e.g. 1)
TRUST_PROXY=

# postgres (optional for dev, required for production)
DATABASE_URL=postgresql://user:password@localhost:5432/arb402

# TLS to postgres is normally configured through the connection string above
# (?sslmode=verify-full) or PGSSLMODE/PGSSLROOTCERT — pg reads those itself.
#
# PGSSL is a DOWNGRADE switch, not an on switch: the exact string "true" forces
# rejectUnauthorized:false, which encrypts but skips certificate verification
# AND overrides sslmode. Leave it unset unless a provider's cert cannot be
# verified any other way. Check the result with `arb402 doctor`.
PGSSL=

# enable DEBUG log lines (INFO/WARN/ERROR always print). presence-checked, so
# ANY non-empty value enables it — including DEBUG=false. leave empty to disable.
DEBUG=

# Settlement token override for the ACTIVE network — required on chains with no
# EIP-3009 default (Arbitrum Nova), and used for custom/test tokens elsewhere.
# The token MUST implement EIP-3009 (transferWithAuthorization).
USDC_ADDRESS=

# EIP-712 domain of that token. Only set these if the token's domain differs
# from Circle's defaults ("USD Coin" / "2") — a mismatch makes every signature
# recover to the wrong address. `arb402 doctor` verifies this against the
# contract's own DOMAIN_SEPARATOR.
USDC_NAME=
USDC_VERSION=

# auth
ADMIN_API_KEY_HASH=

# dev/test only — single-merchant fallback so the facilitator can settle
# without a database (used by the local hardhat harness). NEVER set in production.
DEV_MERCHANT_API_KEY_HASH=
DEV_MERCHANT_ADDRESS=
