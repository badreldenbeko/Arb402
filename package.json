{
  "name": "arb402",
  "version": "0.1.0",
  "description": "HTTP 402 payment facilitator for Arbitrum chains",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "arb402": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli/index.ts",
    "check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "generate-api-key": "tsx scripts/generate-api-key.ts",
    "merchants": "tsx scripts/manage-merchants.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "pg": "^8.16.3",
    "viem": "^2.37.9",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
